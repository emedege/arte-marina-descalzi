---
import '../styles/global.css';
import { locales, t, langNames, WHATSAPP, INSTAGRAM, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  /** Ruta sin idioma, p. ej. "tienda/" ("" para inicio) */
  path: string;
  image?: string;
  noindex?: boolean;
}

const { lang, title, description, path, image, noindex = false } = Astro.props;
const tr = t(lang);
const site = Astro.site!.toString().replace(/\/$/, '');
const desc = description ?? tr.siteDesc;
const canonical = `${site}/${lang}/${path}`;
const fullTitle = title === 'Marina Descalzi' ? 'Marina Descalzi — Arte visual' : `${title} · Marina Descalzi`;
const ogImage = image ? `${site}${image}` : undefined;
const current = Astro.url.pathname;

const nav = [
  { href: `/${lang}/`, label: tr.nav.home, exact: true },
  { href: `/${lang}/tienda/`, label: tr.nav.shop },
  { href: `/${lang}/portfolio/`, label: tr.nav.portfolio },
  { href: `/${lang}/galeria/`, label: tr.nav.gallery },
  { href: `/${lang}/quien-soy/`, label: tr.nav.about },
  { href: `/${lang}/contacto/`, label: tr.nav.contact },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Marina Descalzi',
  alternateName: 'Marina Descalzi Guercio',
  jobTitle: 'Visual artist',
  birthDate: '1990',
  birthPlace: 'Madrid, Spain',
  url: site,
  sameAs: [INSTAGRAM],
};
---

<!doctype html>
<html lang={tr.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {locales.map((l) => <link rel="alternate" hreflang={t(l).htmlLang} href={`${site}/${l}/${path}`} />)}
    <link rel="alternate" hreflang="x-default" href={`${site}/es/${path}`} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Marina Descalzi" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={tr.htmlLang.replace('-', '_')} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="theme-color" content="#ecc4c7" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Raleway:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#main">Saltar al contenido</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={`/${lang}/`}>
          <span class="brand-mark"><img src="/img/logo-mdg-barra.webp" alt="" width="322" height="400" /></span>
          <span>Marina Descalzi</span>
        </a>
        <button class="menu-btn" aria-expanded="false" aria-controls="nav" type="button">Menú</button>
        <nav class="nav" id="nav" aria-label="Principal">
          {nav.map((n) => <a href={n.href} aria-current={(n.exact ? current === n.href : current.startsWith(n.href)) ? 'page' : undefined}>{n.label}</a>)}
          <div class="lang" role="group" aria-label={tr.lang}>
            {locales.map((l) => (
              <a href={`/${l}/${path}`} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>{langNames[l]}</a>
            ))}
          </div>
        </nav>
      </div>
    </header>

    <main id="main"><slot /></main>

    <section class="newsletter" aria-labelledby="news-title">
      <div class="wrap inner">
        <div>
          <h2 id="news-title">{tr.news.title}</h2>
          <p>{tr.news.text}</p>
        </div>
        <!-- TODO: conectar con el servicio de newsletter (pendiente de elegir) -->
        <form action="#" method="post" onsubmit="return false">
          <label class="sr-only" for="nl-email">{tr.news.email}</label>
          <input id="nl-email" type="email" name="email" placeholder={tr.news.email} autocomplete="email" required />
          <button class="btn" type="submit">{tr.news.button}</button>
        </form>
      </div>
    </section>

    <footer class="site-footer">
      <div class="wrap">
        <div class="links">
          <a href={`https://wa.me/${WHATSAPP}`}>WhatsApp</a>
          <a href={INSTAGRAM} rel="me noopener">Instagram</a>
          <a href={`/${lang}/legal/aviso-legal/`}>{tr.footer.legal}</a>
          <a href={`/${lang}/legal/privacidad/`}>{tr.footer.privacy}</a>
          <a href={`/${lang}/legal/cookies/`}>{tr.footer.cookies}</a>
          <a href={`/${lang}/legal/condiciones-de-venta/`}>{tr.footer.terms}</a>
        </div>
        <p>© {new Date().getFullYear()} Marina Descalzi · {tr.footer.rights}</p>
      </div>
    </footer>

    <a class="wa-float" href={`https://wa.me/${WHATSAPP}`} rel="noopener" aria-label={tr.pages.whatsapp} title={tr.pages.whatsapp}>
      <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" focusable="false"><path fill="currentColor" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" /></svg>
    </a>

    <script is:inline>
      // Menú móvil
      var btn = document.querySelector('.menu-btn');
      var nav = document.getElementById('nav');
      btn.addEventListener('click', function () {
        var open = nav.classList.toggle('open');
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
      // El color se revela: en pantallas táctiles, al hacer scroll
      if (window.matchMedia('(hover: none)').matches && 'IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            e.target.classList.toggle('is-revealed', e.isIntersecting);
          });
        }, { rootMargin: '-25% 0px -25% 0px', threshold: 0 });
        document.querySelectorAll('.reveal').forEach(function (el) { io.observe(el); });
      }
      // Vídeos de fondo: si el navegador bloquea el autoplay, se reintenta al primer toque o movimiento
      var bg = document.querySelectorAll('video[autoplay]');
      bg.forEach(function (v) {
        var go = function () { v.play().catch(function () {}); };
        go();
        ['pointerdown', 'touchstart', 'scroll', 'keydown'].forEach(function (ev) {
          window.addEventListener(ev, function once() { go(); window.removeEventListener(ev, once); }, { passive: true });
        });
      });
      // La cita pasa de gris a color al aparecer
      var qs = document.querySelectorAll('.quote');
      if ('IntersectionObserver' in window) {
        var qo = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); qo.unobserve(e.target); } }); }, { threshold: 0.6 });
        qs.forEach(function (q) { qo.observe(q); });
      } else { qs.forEach(function (q) { q.classList.add('in'); }); }
    </script>
  </body>
</html>
