---
import Base from '../../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { locales, t, WHATSAPP, type Lang } from '../../../i18n/ui';

export async function getStaticPaths() {
  const obras = await getCollection('obras');
  return locales.flatMap((lang) => obras.map((o) => ({ params: { lang, slug: o.id }, props: { obra: o } })));
}
const lang = Astro.params.lang as Lang;
const { obra } = Astro.props;
const d = obra.data;
const tr = t(lang);
const tecnica = (lang === 'en' ? d.tecnica_en : lang === 'it' ? d.tecnica_it : undefined) ?? d.tecnica;
const forSale = d.estado === 'disponible';
const wa = `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(tr.work.wa(d.title))}`;
const estadoLabel = d.estado === 'vendida' ? tr.work.sold : d.estado === 'disponible' ? tr.work.available : tr.work.notForSale;
const fmt = (n: number) => new Intl.NumberFormat(tr.htmlLang, { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 }).format(n);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'VisualArtwork',
  name: d.title,
  image: new URL(d.image, Astro.site).toString(),
  creator: { '@type': 'Person', name: 'Marina Descalzi' },
  ...(d.anio && { dateCreated: String(d.anio) }),
  ...(d.tecnica && { artMedium: d.tecnica }),
  ...(forSale && d.precio && {
    offers: { '@type': 'Offer', price: d.precio, priceCurrency: 'EUR', availability: 'https://schema.org/InStock' },
  }),
};
---

<Base
  lang={lang}
  title={d.title}
  description={[d.title, d.medidas, tecnica].filter(Boolean).join('. ')}
  path={`obra/${obra.id}/`}
  image={d.image}
  noindex={d.placeholder}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <div class="wrap work">
    <div class="reveal">
      <img src={d.image} alt={d.alt} width="800" height="1000" decoding="async" fetchpriority="high" />
    </div>
    <div>
      <p class="note"><a href={`/${lang}/tienda/`}>← {tr.work.back}</a></p>
      <h1>{d.title}</h1>
      <p>
        {estadoLabel}
      </p>
      <ul class="facts">
        {d.medidas && <li><span>{tr.work.size}</span><span>{d.medidas}</span></li>}
        {tecnica && <li><span>{tr.work.technique}</span><span>{tecnica}</span></li>}
        {d.exposicion && <li><span>{tr.work.exhibited}</span><span>{d.exposicion}</span></li>}
        {d.anio && <li><span>{tr.work.year}</span><span>{d.anio}</span></li>}
        {d.estado !== 'no a la venta' && <li><span>{tr.work.price}</span><span class="price">{d.precio ? fmt(d.precio) : tr.work.priceAsk}</span></li>}
      </ul>
      {forSale && (
        <>
          <p class="note">{tr.work.shippingIncl}</p>
          <div class="actions">
            <a class="btn solid" href={wa} rel="noopener">{tr.work.buyWhatsapp}</a>
          </div>
          <p class="note">{tr.work.payNote}</p>
        </>
      )}
      {d.placeholder && <p class="placeholder-note">Obra de ejemplo: se sustituirá por las reales.</p>}
    </div>
  </div>
</Base>
