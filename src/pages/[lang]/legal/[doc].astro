---
import Base from '../../../layouts/Base.astro';
import { locales, t, type Lang } from '../../../i18n/ui';
import { textos, nota, TITULAR } from '../../../i18n/legal';

export function getStaticPaths() {
  const docs = ['aviso-legal', 'privacidad', 'cookies', 'condiciones-de-venta'];
  return locales.flatMap((lang) => docs.map((doc) => ({ params: { lang, doc } })));
}
const lang = Astro.params.lang as Lang;
const doc = Astro.params.doc as string;
const tr = t(lang);
const titles: Record<string, string> = {
  'aviso-legal': tr.footer.legal,
  privacidad: tr.footer.privacy,
  cookies: tr.footer.cookies,
  'condiciones-de-venta': tr.footer.terms,
};
const secciones = textos[doc] ?? [];
---

<Base lang={lang} title={titles[doc]} path={`legal/${doc}/`}>
  <div class="wrap page-head">
    <h1>{titles[doc]}</h1>
    {nota[lang] && <p class="note">{nota[lang]}</p>}
  </div>
  <div class="wrap section legal">
    {secciones.map((s) => (
      <section>
        <h2>{s.h}</h2>
        {s.p.map((p) => <p set:html={p} />)}
      </section>
    ))}
    <p class="note">Última actualización: {TITULAR.actualizado}.</p>
  </div>
</Base>
