---
import Base from '../../layouts/Base.astro';
import { locales, t, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const tr = t(lang);
---

<Base lang={lang} title={tr.pages.galTitle} description={tr.pages.galIntro} path="galeria/">
  <div class="wrap page-head">
    <h1>{tr.pages.galTitle}</h1>
    <p>{tr.pages.galIntro}</p>
  </div>
  <div class="wrap section">
    <div class="grid" style="margin-top:0">
      <figure class="video-card">
        <video controls playsinline preload="metadata" poster="/videos/telas-poster.jpg" loop muted>
          <source src="/videos/telas.mp4" type="video/mp4" />
        </video>
        <figcaption>{tr.pages.galVideo1}</figcaption>
      </figure>
    </div>
    <p class="note" style="margin-top:2rem">{tr.pages.galEmpty}</p>
  </div>
</Base>
