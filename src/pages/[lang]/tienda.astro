---
import Base from '../../layouts/Base.astro';
import WorkCard from '../../components/WorkCard.astro';
import Filters from '../../components/Filters.astro';
import { getCollection } from 'astro:content';
import { locales, t, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const tr = t(lang);
const obras = (await getCollection('obras'))
  .filter((o) => o.data.estado !== 'no a la venta')
  .sort((a, b) => a.data.orden - b.data.orden);
const order = ['pintura', 'fotografia', 'collage', 'intervencion', 'diseno'];
const cats = order.filter((c) => obras.some((o) => o.data.categoria === c));
---

<Base lang={lang} title={tr.pages.shopTitle} description={tr.pages.shopIntro} path="tienda/">
  <div class="wrap page-head">
    <h1>{tr.pages.shopTitle}</h1>
    <p>{tr.pages.shopIntro}</p>
  </div>
  <div class="wrap section">
    {obras.length === 0 && <p>{tr.pages.shopEmpty}</p>}
    <Filters lang={lang} cats={cats} />
    <div class="grid" style="margin-top:0">
      {obras.map((o, i) => (
        <WorkCard lang={lang} slug={o.id} title={o.data.title} image={o.data.image} alt={o.data.alt} medidas={o.data.medidas} estado={o.data.estado} categoria={o.data.categoria} loading={i < 3 ? 'eager' : 'lazy'} />
      ))}
    </div>
    <canvas class="firma-pagina firma-centro" data-al-ver aria-hidden="true"></canvas>
  </div>
</Base>
