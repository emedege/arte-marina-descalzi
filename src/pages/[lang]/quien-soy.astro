---
import Base from '../../layouts/Base.astro';
import { locales, t, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const tr = t(lang);
---

<Base lang={lang} title={tr.pages.aboutTitle} description={tr.siteDesc} path="quien-soy/" image="/img/marina-descalzi.webp">
  <div class="wrap page-head">
    <h1>{tr.pages.aboutTitle}</h1>
  </div>
  <div class="wrap section about">
    <div class="about-photo">
      <canvas class="firma-pagina firma-foto" data-al-ver aria-hidden="true"></canvas>
      <div class="reveal">
        <img src="/img/marina-descalzi.webp" alt={tr.pages.aboutAlt} width="1100" height="1375" fetchpriority="high" decoding="async" />
      </div>
    </div>
    <div>
      {tr.pages.aboutText.map((p, n) => {
        const nombre = 'Marina Descalzi Guercio';
        if (n === 0 && p.includes(nombre)) {
          const [antes, despues] = p.split(nombre);
          return (
            <>
              <p class="about-name">{antes}<strong>{nombre}</strong><canvas class="firma-pagina firma-nombre" data-tras=".firma-foto" data-al-ver aria-hidden="true"></canvas></p>
              <p>{despues.trim()}</p>
            </>
          );
        }
        return <p>{p}</p>;
      })}
    </div>
  </div>
</Base>
