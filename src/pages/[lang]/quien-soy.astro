---
import Base from '../../layouts/Base.astro';
import { locales, t, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const tr = t(lang);
---

<Base lang={lang} title={tr.pages.aboutTitle} description={tr.siteDesc} path="quien-soy/" image="/img/marina-descalzi.webp">
  <div class="wrap page-head">
    <h1>{tr.pages.aboutTitle}</h1>
  </div>
  <div class="wrap section about">
    <div class="reveal">
      <img src="/img/marina-descalzi.webp" alt={tr.pages.aboutAlt} width="1100" height="1375" fetchpriority="high" decoding="async" />
    </div>
    <div>
      <p>{tr.pages.aboutText}</p>
    </div>
  </div>
</Base>
