---
import Base from '../../layouts/Base.astro';
import { locales, t, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const tr = t(lang);
---

<Base lang={lang} title={tr.pages.aboutTitle} description={tr.siteDesc} path="quien-soy/">
  <div class="wrap page-head">
    <h1>{tr.pages.aboutTitle}</h1>
  </div>
  <div class="wrap section">
    <p style="max-width:40rem">{tr.pages.aboutText}</p>
  </div>
</Base>
