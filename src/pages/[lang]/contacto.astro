---
import Base from '../../layouts/Base.astro';
import { locales, t, WHATSAPP, INSTAGRAM, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const tr = t(lang);
const wa = (msg: string) => `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(msg)}`;
---

<Base lang={lang} title={tr.pages.contactTitle} description={tr.pages.contactIntro} path="contacto/">
  <div class="wrap page-head">
    <h1>{tr.pages.contactTitle}</h1>
    <p>{tr.pages.contactIntro}</p>
  </div>
  <div class="wrap section contact-grid">
    <div class="actions" style="margin-top:0">
      <a class="btn solid" href={`https://wa.me/${WHATSAPP}`} rel="noopener">{tr.pages.whatsapp}</a>
      <a class="btn" href={wa(tr.pages.dossierMsg)} rel="noopener">{tr.pages.dossier}</a>
      <a class="btn" href={INSTAGRAM} rel="me noopener">{tr.pages.instagram}</a>
    </div>
    <span class="logo-draw logo-contacto" data-al-ver role="img" aria-label="Marina Descalzi"><img class="l-fin" src="/img/logo-mdg.svg" alt="" width="400" height="944" decoding="async" /><canvas class="l-lienzo" aria-hidden="true"></canvas></span>
  </div>
    <div class="firma-fila"><canvas class="firma-pagina firma-centro" data-al-ver aria-hidden="true"></canvas></div>
  <script is:inline src="/js/logo-pincel.js"></script>
</Base>
