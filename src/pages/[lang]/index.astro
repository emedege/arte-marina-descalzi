---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { locales, t, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const tr = t(lang);

const obras = (await getCollection('obras')).sort((a, b) => a.data.orden - b.data.orden);
const slides = obras.filter((o) => o.data.categoria === 'fotografia').slice(0, 8);
const pick = (i: number) => obras[i]?.data;
const tiles = [
  { href: 'tienda', title: tr.home.shopT, desc: tr.home.shopD, work: pick(0) },
  { href: 'portfolio', title: tr.home.portT, desc: tr.home.portD, work: { image: '/obras/intervencion-tabla-madera.webp' } },
  { href: 'galeria', title: tr.home.galT, desc: tr.home.galD, work: { image: '/obras/intervencion-mosaico-materiales.webp' } },
];
---

<Base lang={lang} title="Marina Descalzi" path="">
  <section class="intro">
    <div class="wrap">
      <span class="logo-mark logo-draw" role="img" aria-label="Marina Descalzi"><img class="l-fin" src="/img/logo-mdg.webp" alt="" width="322" height="400" decoding="async" /><canvas class="l-lienzo" width="322" height="400" aria-hidden="true"></canvas></span>
      <h1>{tr.home.tagline}</h1>
      <p class="sub">{tr.home.sub}</p>
      <a class="btn solid" href={`/${lang}/tienda/`}>{tr.home.cta}</a>
    </div>
  </section>

  <section class="section">
    <div class="wrap triptych penta">
      {tiles.map((x) => (
        <a href={`/${lang}/${x.href}/`}>
          <div class="reveal">{x.work && <img src={x.work.image} alt="" width="800" height="1000" loading="lazy" decoding="async" />}</div>
          <h2>{x.title}</h2>
          <p>{x.desc}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="video-band">
    <div class="wrap">
      <div class="video-box">
        <div class="clips">
          <video class="on" autoplay muted playsinline preload="metadata" poster="/videos/telas-poster.jpg" aria-hidden="true">
            <source src="/videos/telas.mp4" type="video/mp4" />
          </video>
          <video muted playsinline preload="none" poster="/videos/video2-poster.jpg" aria-hidden="true">
            <source src="/videos/video2.mp4" type="video/mp4" />
          </video>
          <div class="frame-stage" aria-hidden="true">
            {slides.map((sl, i) => (
              <div class={i === 0 ? 'slide on' : 'slide'}><img src={sl.data.image} alt="" width="800" height="1000" loading="lazy" /></div>
            ))}
          </div>
        </div>
        <button class="hero-pause" type="button" aria-pressed="false" aria-label={tr.home.pause} title={tr.home.pause} data-pause={tr.home.pause} data-play={tr.home.play}>
          <svg class="i-pause" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M6 5h4v14H6zM14 5h4v14h-4z" /></svg>
          <svg class="i-play" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M8 5v14l11-7z" /></svg>
        </button>
      </div>
    </div>
  </section>

  <div class="penta-sep" aria-hidden="true"><i></i><i></i><i></i></div>

  <section class="quote-band">
    <div class="wrap">
      <blockquote class="quote"><p>{tr.home.quote}</p></blockquote>
    </div>
  </section>

  <script is:inline>
    (function () {
      // El logo se pinta siguiendo los trazos: primero la M, luego la D y luego la G
      (function () {
        var box = document.querySelector('.logo-draw');
        if (!box) return;
        var cv = box.querySelector('.l-lienzo'), fin = box.querySelector('.l-fin');
        var load = function (src) { return new Promise(function (ok, ko) { var im = new Image(); im.onload = function () { ok(im); }; im.onerror = ko; im.src = src; }); };
        Promise.all([load('/img/logo-mdg.webp'), load('/img/logo-mdg-tiempo.png')]).then(function (r) {
          var W = cv.width, H = cv.height, ctx = cv.getContext('2d');
          var grab = function (im) { var c = document.createElement('canvas'); c.width = W; c.height = H; var x = c.getContext('2d'); x.drawImage(im, 0, 0, W, H); return x.getImageData(0, 0, W, H).data; };
          var src = grab(r[0]), tm = grab(r[1]);
          var out = ctx.createImageData(W, H), od = out.data;
          od.set(src);
          for (var i = 0; i < W * H; i++) od[i * 4 + 3] = 0;
          ctx.putImageData(out, 0, 0);
          box.classList.add('pintando');
          var DUR = 4600, SOFT = 0.035, t0 = null;
          function frame(now) {
            if (t0 === null) t0 = now;
            var p = Math.min(1, (now - t0) / DUR);
            var edge = p * (1 + SOFT);
            for (var k = 0; k < W * H; k++) {
              var tt = tm[k * 4] / 254;
              var a = tm[k * 4] === 255 ? 0 : Math.min(1, Math.max(0, (edge - tt) / SOFT));
              od[k * 4 + 3] = src[k * 4 + 3] * a;
            }
            ctx.putImageData(out, 0, 0);
            if (p < 1) requestAnimationFrame(frame);
            else { box.classList.add('pintado'); }
          }
          requestAnimationFrame(frame);
        }).catch(function () {});
      })();
      // Frases letra a letra
      function tipea(el, delay, slowFrom) {
        var txt = el.textContent.trim();
        el.setAttribute('aria-label', txt);
        el.textContent = '';
        var i = 0; var d = 0; var pos = 0;
        txt.split(' ').forEach(function (word, k) {
          var w = document.createElement('span'); w.className = 'w'; w.setAttribute('aria-hidden', 'true');
          word.split('').forEach(function (ch) {
            var c = document.createElement('span'); c.className = 'c'; c.textContent = ch; var slow = slowFrom != null && pos >= slowFrom; if (slow && pos === slowFrom) d += 700; d += slow ? 170 : 55; if (slow) c.setAttribute('data-slow', ''); c.style.setProperty('--d', d + 'ms'); c.style.setProperty('--t', slow ? '0.9s' : '0.35s'); pos++; i++; w.appendChild(c);
          });
          el.appendChild(w);
          if (k < txt.split(' ').length - 1) { el.appendChild(document.createTextNode(' ')); pos++; d += (slowFrom != null && pos > slowFrom) ? 170 : 55; }
        });
        el.classList.add('tipea');
        return function () {
          setTimeout(function () { el.classList.add('go'); }, delay || 0);
          if (slowFrom != null) setTimeout(function () { el.classList.add('vela'); }, (delay || 0) + d + 400);
        };
      }
      var tag = document.querySelector('.intro h1');
      if (tag) { var cut = tag.textContent.indexOf('Se '); var startTag = tipea(tag, 4300, cut > 0 ? cut : null); startTag(); }
      var q = document.querySelector('.quote p');
      if (q) {
        var startQ = tipea(q, 0);
        if ('IntersectionObserver' in window) {
          var qio = new IntersectionObserver(function (es) { if (es[0].isIntersecting) { startQ(); qio.disconnect(); } }, { threshold: 0.6 });
          qio.observe(q);
        } else { startQ(); }
      }
      // Velo: cubre las imágenes de la portada y se levanta al bajar
      var root = document.documentElement;
      {
        var ticking = false;
        var veil = function () {
          var v = 1 - Math.min(1, Math.max(0, window.scrollY / (window.innerHeight * 0.4)));
          root.style.setProperty('--veil', v.toFixed(3));
          ticking = false;
        };
        window.addEventListener('scroll', function () { if (!ticking) { ticking = true; requestAnimationFrame(veil); } }, { passive: true });
        veil();
      }

      var slides = document.querySelectorAll('.frame-stage .slide');
      var videos = document.querySelectorAll('.video-box video');
      var state = { slides: false, videos: false };
      var si = 0;
      var vi = 0;

      if (slides.length > 1) {
        setInterval(function () {
          if (state.slides) return;
          slides[si].classList.remove('on');
          si = (si + 1) % slides.length;
          slides[si].classList.add('on');
        }, 3000);
      }

      // Vídeos: solo se reproducen cuando la caja está a la vista, y se alternan al terminar
      var box = document.querySelector('.video-box');
      var visible = false;
      function playCurrent() { if (!state.videos && visible) videos[vi].play().catch(function () {}); }
      videos.forEach(function (v, k) {
        v.addEventListener('ended', function () {
          if (state.videos) return;
          v.classList.remove('on');
          vi = (k + 1) % videos.length;
          videos[vi].currentTime = 0;
          videos[vi].classList.add('on');
          playCurrent();
        });
      });
      if (box && 'IntersectionObserver' in window) {
        new IntersectionObserver(function (es) {
          visible = es[0].isIntersecting;
          if (visible) playCurrent(); else videos[vi].pause();
        }, { threshold: 0.35 }).observe(box);
      } else { visible = true; playCurrent(); }

      var btn = document.querySelector('.hero-pause');
      if (btn) btn.addEventListener('click', function () {
        var p = !state.videos;
        state.videos = p; state.slides = p;
        btn.setAttribute('aria-pressed', p ? 'true' : 'false');
        btn.setAttribute('aria-label', btn.getAttribute(p ? 'data-play' : 'data-pause'));
        btn.setAttribute('title', btn.getAttribute('aria-label'));
        if (p) videos[vi].pause(); else playCurrent();
      });
    })();
  </script>
</Base>
