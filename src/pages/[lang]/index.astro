---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { locales, t, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const tr = t(lang);

const obras = (await getCollection('obras')).sort((a, b) => a.data.orden - b.data.orden);
const slides = obras.slice(0, 6);
const pick = (i: number) => obras[i]?.data;
const tiles = [
  { href: 'tienda', title: tr.home.shopT, desc: tr.home.shopD, work: pick(0) },
  { href: 'portfolio', title: tr.home.portT, desc: tr.home.portD, work: pick(1) },
  { href: 'galeria', title: tr.home.galT, desc: tr.home.galD, work: pick(2) },
];
---

<Base lang={lang} title="Marina Descalzi" path="">
  <section class="hero" aria-label={tr.home.tagline}>
    <div class="hero-bg">
      <video class="on" autoplay muted playsinline preload="auto" poster="/videos/telas-poster.jpg" aria-hidden="true">
        <source src="/videos/telas.mp4" type="video/mp4" />
      </video>
      <video muted playsinline preload="metadata" poster="/videos/pintura-poster.jpg" aria-hidden="true">
        <source src="/videos/pintura.mp4" type="video/mp4" />
      </video>
    </div>
    <div class="frame-stage" aria-hidden="true">
      {slides.map((s, i) => (
        <div class={i === 0 ? 'slide on' : 'slide'}><img src={s.data.image} alt="" width="800" height="1000" loading={i === 0 ? 'eager' : 'lazy'} /></div>
      ))}
    </div>
    <button class="hero-pause" type="button" aria-pressed="false" aria-label={tr.home.pause} title={tr.home.pause} data-pause={tr.home.pause} data-play={tr.home.play}>
      <svg class="i-pause" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M6 5h4v14H6zM14 5h4v14h-4z" /></svg>
      <svg class="i-play" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M8 5v14l11-7z" /></svg>
    </button>
  </section>

  <section class="intro">
    <div class="wrap">
      <img class="logo-mark" src="/img/logo-mdg.webp" alt="Marina Descalzi" width="322" height="400" loading="lazy" decoding="async" />
      <h1>{tr.home.tagline}</h1>
      <p class="sub">{tr.home.sub}</p>
      <a class="btn solid" href={`/${lang}/tienda/`}>{tr.home.cta}</a>
    </div>
  </section>

  <section class="section">
    <div class="wrap triptych">
      {tiles.map((x) => (
        <a href={`/${lang}/${x.href}/`}>
          <div class="reveal">{x.work && <img src={x.work.image} alt="" width="800" height="1000" loading="lazy" decoding="async" />}</div>
          <h2>{x.title}</h2>
          <p>{x.desc}</p>
        </a>
      ))}
    </div>
  </section>
<section class="quote-band">
    <div class="wrap">
      <blockquote class="quote"><p>{tr.home.quote}</p></blockquote>
    </div>
  </section>

  <script is:inline>
    (function () {
      var slides = document.querySelectorAll('.frame-stage .slide');
      var videos = document.querySelectorAll('.hero-bg video');
      var vi = 0;
      videos.forEach(function (v, k) {
        v.addEventListener('ended', function () {
          if (paused) return;
          v.classList.remove('on');
          vi = (k + 1) % videos.length;
          videos[vi].currentTime = 0;
          videos[vi].classList.add('on');
          videos[vi].play().catch(function () {});
        });
      });
      var btn = document.querySelector('.hero-pause');
      var paused = false;
      var i = 0;
      if (slides.length > 1) {
        setInterval(function () {
          if (paused) return;
          slides[i].classList.remove('on');
          i = (i + 1) % slides.length;
          slides[i].classList.add('on');
        }, 4500);
      }
      if (btn) {
        btn.addEventListener('click', function () {
          paused = !paused;
          btn.setAttribute('aria-pressed', paused ? 'true' : 'false');
          btn.setAttribute('aria-label', paused ? btn.getAttribute('data-play') : btn.getAttribute('data-pause'));
          btn.setAttribute('title', btn.getAttribute('aria-label'));
          if (paused) videos[vi].pause(); else videos[vi].play().catch(function () {});
        });
      }
    })();
  </script>

</Base>
