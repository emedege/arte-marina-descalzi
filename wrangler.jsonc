{
  "name": "marina-descalzi",
  "main": "worker.js",
  "vars": { "DOMINIO_ACTIVO": "no" },
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
